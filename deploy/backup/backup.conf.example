# Конфиг бэкапа SonetCord. На сервере: /etc/zovcord-backup.conf, chmod 600, root:root.
# В git НЕ коммитить — здесь секреты.

# --- Приложение --------------------------------------------------------------
APP_DIR="/path/to/laravel"          # корень Laravel (внутри лежит .env)

# --- Яндекс.Диск -------------------------------------------------------------
YADISK_CLIENT_ID="YOUR_YANDEX_CLIENT_ID"
YADISK_CLIENT_SECRET="ЗАПОЛНИТЬ"    # секрет приложения с oauth.yandex.ru
YADISK_REFRESH_TOKEN=""             # выдаст get-token.sh; скрипт обновляет строку сам
YADISK_TOKEN=""                     # можно задать вручную вместо refresh (протухнет через ~год)
YADISK_DIR="app:/your-app"          # app:/ = папка «Приложения/<имя>», токен не видит остальной Диск

# --- Почта -------------------------------------------------------------------
# Пустые SMTP_* берутся из MAIL_* в .env приложения — там уже рабочий ящик.
# Заполнять здесь нужно, только если письма должны идти с другого адреса.
MAIL_TO="ops@example.com"            # куда слать отчёты
MAIL_FROM=""                        # пусто = MAIL_FROM_ADDRESS из .env
SMTP_HOST=""                        # пусто = MAIL_HOST из .env
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""                        # если задаёте вручную — это ПАРОЛЬ ПРИЛОЖЕНИЯ
MAIL_ON_SUCCESS="1"                 # 0 = писать только при провале

# --- Шифрование --------------------------------------------------------------
# В дампе вся переписка пользователей. Пустое значение = зальётся открытым текстом.
# Пароль хранить ВНЕ сервера: потеряете — бэкапы не восстановить.
GPG_PASSPHRASE=""

# --- Хранение ----------------------------------------------------------------
RETENTION_DAYS="30"                 # сколько держать копии на Яндекс.Диске
LOCAL_RETENTION_DAYS="3"            # сколько держать локально в BACKUP_DIR
BACKUP_DIR="/var/backups/laravel-app"
LOG_FILE="/var/log/laravel-backup.log"

# --- Вложения (storage/app) --------------------------------------------------
# Гоняются раз в неделю: меняются медленно, а весят на порядки больше базы.
BACKUP_STORAGE="1"
STORAGE_WEEKDAY="7"                 # 1=пн … 7=вс
# Файлы крупнее порога в архив не берём. 25 МБ совпадает с
# uploads.encrypt_max_bytes: ровно то, что приложение шифрует на диске.
STORAGE_MAX_FILE_MB="25"

# --- Необязательное ----------------------------------------------------------
# Пинг после успеха. Если ночью пинга не было — healthchecks.io пришлёт письмо.
# Ловит случай «сервер умер и скрипт вообще не запускался», который сам скрипт
# отловить не может по определению.
HEALTHCHECK_URL=""
