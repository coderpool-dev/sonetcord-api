APP_NAME=SonetCord
APP_ENV=local
APP_KEY=
# ВНИМАНИЕ: APP_DEBUG=true раскрывает стектрейсы и текст исключений клиенту.
# Держите false на проде; включайте локально только для отладки.
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Origins фронтенда, которым разрешён CORS (через запятую).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# For production use a real mailer. MAIL_MAILER=log only writes emails to storage/logs
# and users will not receive verification/password reset links.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Optional Yandex Music integration ---
YANDEX_MUSIC_CLIENT_ID=
YANDEX_MUSIC_CLIENT_SECRET=

# --- WebRTC TURN/STUN ---
# Собственный TURN-сервер (coturn). Хост без схемы, только домен или IP.
# Если оставить пустым — отдаются только публичные STUN, и часть звонков
# (симметричный NAT / мобильные операторы / строгий файрвол) не соединится.
TURN_HOST=
TURN_USERNAME=
TURN_CREDENTIAL=
# Общий секрет coturn (use-auth-secret + static-auth-secret): если задан, клиенты получают временные данные TURN.
TURN_SECRET=
TURN_CREDENTIAL_TTL=86400
TURN_TLS_HOST=
TURN_TLS_PORT=

# Альтернатива своему серверу — Cloudflare TURN (если не поднимаешь coturn).
CF_TURN_USERNAME=
CF_TURN_CREDENTIAL=

# --- Шифрование сообщений (AES-256-GCM) ---
# 32 байта ключа в base64. Сгенерировать: `php -r "echo base64_encode(random_bytes(32));"`
# Не коммитьте реальные значения. Смена ключа сломает чтение старых сообщений.
ENCRYPTION_KEY_1=
# Идентификатор ключа, которым шифруются новые сообщения (соответствует ENCRYPTION_KEY_N).
ENCRYPTION_ACTUAL=1

# Персональная квота на вложения (в байтах). 2 ГБ = 2147483648.
# Полный список лимитов вложений — см. config/uploads.php.
UPLOAD_USER_QUOTA_BYTES=2147483648

# 0 = ретеншн выключен (старые сообщения/вложения не удаляются автоматически).
UPLOAD_RETENTION_DAYS=0

# Additional integration and queue settings
WEBPUSH_QUEUE_CONNECTION=database
MAIL_TIMEOUT=10
YANDEX_SMARTCAPTCHA_SERVER_KEY=
YANDEX_SMARTCAPTCHA_VALIDATE_URL=https://smartcaptcha.cloud.yandex.ru/validate
